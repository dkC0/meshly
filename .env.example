# Meshly — Environment Variables
# Copy this file to .env.local and fill in actual values

# Site URL — used for canonical URLs and OG metadata
NEXT_PUBLIC_SITE_URL=https://meshly.pl

# Analytics (optional — Vercel Analytics is configured in layout.tsx)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# Contact form — email delivery via Resend (https://resend.com)
# RESEND_API_KEY — your Resend API key, used to send the notification email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CONTACT_TO_EMAIL — inbox address that receives new project inquiries
CONTACT_TO_EMAIL=hello@meshly.pl
